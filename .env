
# Ollama Configuration

OLLAMA_HOST=http://ollama:11435
 
# Frontend

REACT_APP_OLLAMA_URL=http://ollama:11435

REACT_APP_BACKEND_URL=http://backend:8000
 
# Backend

PYTHONUNBUFFERED=1

CHROMA_HOST=chromadb

CHROMA_PORT=8000

# Backend API URL
VITE_API_BASE_URL=http://192.168.1.17:8000

# Ollama Host (if needed for direct connection)
VITE_OLLAMA_HOST=http://ollamq:11435



# MCP Server Environment Variables
# Copy this file to .env and update with your values

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7

# PostgreSQL Configuration
POSTGRES_DB=mcp_db
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=mcp_password
POSTGRES_CONNECTION=postgresql://mcp_user:mcp_password@postgres:5432/mcp_db

# SQLite Configuration
SQLITE_CONNECTION=sqlite:///./data/mcp_data.db

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data

# Document Storage
DOCUMENT_STORAGE=./documents

# API Registry
API_REGISTRY=./api_registry.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/mcp_server.log

# Security (Optional)
# API_KEY=your-secret-api-key-here
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000